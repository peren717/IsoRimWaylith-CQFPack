<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - Custom Quest Framework Pack, batch B1 gate: binds the models on IsoRim Api 50+ (byGraphic with Graphic_Random variants).
     Every field newer than a plain model is added here, so an older IsoRim never reads it. -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>50</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_CQF_TreasureChest"]</xpath>
      <value>
        <thingDef>QE_TreasureChest</thingDef>
        <byGraphic><li><path>Things/Building/LootBox/TreasureChest/TreasureChest_opened</path><model>Models/cqf_chest_open.obj</model></li></byGraphic>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>50</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_CQF_Cabinet"]</xpath>
      <value>
        <thingDef>QE_Cabinet</thingDef>
        <rotationByFacing><li>0</li><li>0</li><li>180</li><li>0</li></rotationByFacing>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>50</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_CQF_Crate"]</xpath>
