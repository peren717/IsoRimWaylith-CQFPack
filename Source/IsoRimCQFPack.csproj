<Project Sdk="Microsoft.NET.Sdk">
  <!-- IsoRimProjectZ.dll is IsoRimZ's (public Api, Api 9+; Api 11 members behind a version check).
       QuestEditor_Library.dll is Custom Quest Framework's, referenced in place and never copied.
       Build paths (overridable): the repo root's Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimWaylith_CQFPack</AssemblyName>
    <RootNamespace>IsoRimCQFPack</RootNamespace>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="QuestEditor_Library"><HintPath>$(CQFDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRimProjectZ"><HintPath>$(ProjectZDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRim"><HintPath>$(IsoRimDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
